<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Orders | TailorPro</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-links">
        <span>TailorPro • Digital tailoring orders</span>
        <div class="auth-nav">
          <% if (user) { %>
            <span class="user-welcome">Welcome, <%= user.name %>!</span>
            <a href="/profile">My Profile</a>
            <a href="/cart">Cart (<%= cartCount %>)</a>
            <% if (user.role === 'admin') { %>
              <a href="/admin/dashboard">Admin Panel</a>
            <% } %>
            <a href="/logout">Logout</a>
          <% } else { %>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
          <% } %>
        </div>
      </div>
      <div class="order-summary">You have placed <%= orders.length %> orders.</div>
    </div>
  </div>

  <main class="orders-container">
    <div class="container">
      <h1>My Orders</h1>
      <% if (orders.length === 0) { %>
        <div class="empty-state">You haven't placed any orders yet. Add products to your cart to get started.</div>
        <a class="btn btn-primary" href="/products">Browse Products</a>
      <% } else { %>
        <div class="orders-list">
          <% orders.forEach(order => { %>
            <section class="order-card">
              <header>
                <h2>Order #<%= order._id.toString().slice(-6).toUpperCase() %></h2>
                <span class="badge badge-status <%= order.status.toLowerCase() %>"><%= order.status %></span>
              </header>
              <div class="order-meta">
                <p><strong>Placed:</strong> <%= new Date(order.createdAt).toLocaleString() %></p>
                <p><strong>Total:</strong> $<%= order.total.toFixed(2) %></p>
              </div>
              <div class="order-shipping">
                <p><strong>Shipping Address:</strong> <%= order.shipping.address %>, <%= order.shipping.city %>, <%= order.shipping.state %> <%= order.shipping.zip %></p>
              </div>
              <div class="order-items">
                <% order.items.forEach(item => { %>
                  <div class="order-item-row">
                    <span><%= item.quantity %> x <%= item.name %></span>
                    <span>$<%= (item.price * item.quantity).toFixed(2) %></span>
                  </div>
                <% }) %>
              </div>
            </section>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
