<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | TailorPro Admin</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-page">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-brand">TailorPro Admin</div>
      <nav>
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/products/new" class="active">Add Product</a>
        <a href="/admin/logout">Logout</a>
      </nav>
    </aside>
    <main class="admin-main">
      <header class="admin-header">
        <h1><%= title %></h1>
        <p>Use this form to add or update product information for the inventory.</p>
      </header>

      <div class="admin-panel admin-form-card">
        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form action="<%= action %>" method="POST" enctype="multipart/form-data" class="admin-form">
          <div class="form-row">
            <label for="name">Product Name</label>
            <input id="name" name="name" type="text" value="<%= product.name %>" required>
          </div>
          <div class="form-row">
            <label for="category">Category</label>
            <input id="category" name="category" type="text" value="<%= product.category %>" required>
          </div>
          <div class="form-row">
            <label for="price">Price</label>
            <input id="price" name="price" type="number" step="0.01" value="<%= product.price %>" required>
          </div>
          <div class="form-row">
            <label for="stock">Stock Quantity</label>
            <input id="stock" name="stock" type="number" value="<%= product.stock %>" required>
          </div>
          <div class="form-row">
            <label for="rating">Rating</label>
            <input id="rating" name="rating" type="number" step="0.1" min="0" max="5" value="<%= product.rating %>">
          </div>
          <div class="form-row">
            <label for="image">Product Image</label>
            <input id="image" name="image" type="file" accept="image/*">
          </div>
          <% if (product.image) { %>
            <div class="form-row product-preview-row">
              <label>Current Image</label>
              <img class="admin-thumb" src="<%= product.image %>" alt="Current product image">
            </div>
          <% } %>
          <button type="submit" class="btn btn-primary"><%= title.includes('Add') ? 'Create Product' : 'Save Changes' %></button>
        </form>
      </div>
    </main>
  </div>
</body>
</html>
